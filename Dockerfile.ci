FROM python:3.13-slim

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install deps via editable install. Copy only what's needed so this
# layer caches on pyproject changes, not source-code changes.
COPY pyproject.toml ./
RUN touch README.md
COPY src ./src
RUN pip install -e ".[dev]"

# Repo code is mounted at /workspace at runtime by the CI workflow.
CMD ["bash", "scripts/ci-checks.sh", "smoke"]
